-- ==========================================
-- 1. SEGURANÇA DE PONTA (BYPASS TRIPLO)
-- ==========================================
-- Proteção 1: Impede Kick direto
pcall(function() game.Players.LocalPlayer.Kick = function() end end)

-- Proteção 2: Hook Avançado (Bloqueia Kick e limpa logs de erro)
pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" then return nil end
        -- Impede que o jogo veja a criação de GUIs de hacks
        if method == "FindFirstChild" and tostring(select(1, ...)) == "IlhaBelaAntiCheat" then
            return nil 
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

-- Proteção 3: Limpeza de logs de erro (evita que o anti-cheat leia falhas do script)
local oldError = error
error = function(msg, level)
    if string.find(tostring(msg), "attempt to index") or string.find(tostring(msg), "Drawing") then
        return nil -- Ignora erros de UI do nosso script
    end
    return oldError(msg, level)
end

