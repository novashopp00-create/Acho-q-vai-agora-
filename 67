-- 3. CONFIGURAÇÕES (Otimizadas)
-- ==========================================
local Config = {
    ESP_Players = false,
    ESP_MaxDist = 500,
    ESP_BoxColor = Color3.fromRGB(0, 255, 0),
    ESP_TracerColor = Color3.fromRGB(255, 0, 0),
    ESP_ShowHealth = true,
    ESP_ShowName = true,
    
    Aimbot = false,
    Aim_FOV = 120,
    Aim_Smooth = 0.15,
    Aim_WallCheck = true,
    Aim_HoldKey = false
}

-- Cache de desenhos (Para evitar travamentos e Memory Leak)
local DrawingsCache = {}

local function ClearDrawings()
    for _, obj in pairs(DrawingsCache) do
        pcall(function()
            if typeof(obj) == "Instance" then obj:Destroy() else obj:Remove() end
        end)
    end
    table.clear(DrawingsCache)
end

-- Círculo do FOV (Criado uma única vez, apenas escondido/mostrado)
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1
FOVCircle.NumSides = 60
FOVCircle.Transparency = 1
FOVCircle.Filled = false
FOVCircle.Visible = false

-- ==========================================
-- 4. FUNÇÕES AUXILIARES BLINDADAS
-- ==========================================
local function CreateDrawing(class, properties)
    local obj = Drawing.new(class)
    for k, v in pairs(properties) do obj[k] = v end
    table.insert(DrawingsCache, obj)
    return obj
end

local function FindHead(char)
    if not char then return nil end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

-- ==========================================
-- 5. LOOP PRINCIPAL (RenderStepped)
-- ==========================================
RunService.RenderStepped:Connect(function()
    -- === FOV VISUAL ===
    if Config.Aimbot then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = Config.Aim_FOV
        FOVCircle.Color = Color3.fromRGB(255, 255, 255)
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- === AIMBOT ===
    if Config.Aimbot and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local active = true
        if Config.Aim_HoldKey then
            active = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        end

        if active then
            local closest, dist = nil, Config.Aim_FOV
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hum = plr.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local head = FindHead(plr.Character)
                        if head then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local mag = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                if mag < dist then
                                    -- Wall Check Otimizado (Novo método do Roblox)
                                    if Config.Aim_WallCheck then
                                        local rayParams = RaycastParams.new()
                                        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
                                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                        local rayResult = workspace:Raycast(Camera.CFrame.Position, head.Position - Camera.CFrame.Position, rayParams)
                                        
                                        if rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(plr.Character) then
                                            closest = head
                                            dist = mag
                                        end
                                    else
                                        closest = head
                                        dist = mag
                                    end
                                end
                            end
                        end
                    end
                end
            end

            -- Humanização e Suavidade da Mira
            if closest then
                local targetPos = closest.Position
                if Config.Aim_Smooth > 0 then
                    -- O Lerp suaviza a mira, evitando bans instantâneos
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), Config.Aim_Smooth)
                else
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                end
            end
        end
    end

    -- === ESP ===
    ClearDrawings()
    if Config.ESP_Players then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                
                if dist <= Config.ESP_MaxDist then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        -- Caixa
                        local boxSize = Vector2.new(50, 70)
                        CreateDrawing("Square", {
                            Visible = true, Color = Config.ESP_BoxColor, Thickness = 1,
                            Filled = false, Size = boxSize,
                            Position = Vector2.new(screenPos.X, screenPos.Y) - (boxSize / 2)
                        })

                        -- Linha
                        CreateDrawing("Line", {
                            Visible = true, Color = Config.ESP_TracerColor, Thickness = 1,
                            From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y),
                            To = Vector2.new(screenPos.X, screenPos.Y)
                        })

                        -- Nome
                        if Config.ESP_ShowName then
                            CreateDrawing("Text", {
                                Visible = true, Color = Color3.fromRGB(255, 255, 255), Size = 14,
                                Center = true, Outline = true,
                                Text = plr.Name .. " [" .. math.floor(dist) .. "m]",
                                Position = Vector2.new(screenPos.X, screenPos.Y - 40)
                            })
                        end
                    end
                end
            end
        end
    end
end)

